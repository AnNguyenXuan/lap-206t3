1. Cấu hình VLAN, trunk và LACP giữa 2 switch LAN A

Trên SW1
enable
conf t
hostname SW1

vlan 100
 name VLAN100
exit

vlan 200
 name VLAN200
exit

interface fa0/1
 description TRUNK_TO_ROUTER0
 switchport mode trunk
 switchport trunk allowed vlan 100,200
 spanning-tree portfast trunk
 no shutdown
exit

interface range fa0/21-24
 description LACP_TO_SW
 switchport mode trunk
 switchport trunk allowed vlan 100,200
 channel-group 1 mode active
 no shutdown
exit

interface port-channel 1
 description LACP_TO_SW
 switchport mode trunk
 switchport trunk allowed vlan 100,200
exit

end
wr

