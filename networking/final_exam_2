2. Cấu hình Inter-VLAN Routing trên Router0

enable
conf t
hostname R0

interface fa0/0
 description TO_SW1
 no ip address
 no shutdown
exit

interface fa0/0.100
 description GATEWAY_VLAN100
 encapsulation dot1Q 100
 ip address 172.16.10.1 255.255.255.0
exit

interface fa0/0.200
 description GATEWAY_VLAN200
 encapsulation dot1Q 200
 ip address 172.16.20.1 255.255.255.0
exit

interface fa0/1
 description TO_R1
 ip address 209.165.2.1 255.255.255.252
 clock rate 64000
 no shutdown
exit

end
wr

