enable
conf t
hostname EDGE
no ip domain-lookup

interface s0/0/0
 description TO_R1
 ip address 13.0.0.2 255.255.255.0
 ip nat inside
 no shutdown

interface s0/0/1
 description TO_R2
 ip address 14.0.0.2 255.255.255.0
 ip nat inside
 no shutdown

interface fa0/0
 description TO_SERVER
 ip address 209.165.10.1 255.255.255.252
 ip nat outside
 no shutdown

router ospf 20
 router-id 3.3.3.3
 network 13.0.0.0 0.0.0.255 area 0
 network 14.0.0.0 0.0.0.255 area 0
 network 209.165.10.0 0.0.0.3 area 0
 passive-interface fa0/0

end
wr

conf t

ip access-list extended EDGE_POLICY
 remark Permit OSPF routing
 permit ospf any any

 remark Block PC1 ping Server
 deny icmp host 192.168.10.10 host 209.165.10.2

 remark Allow PC2 ping Server
 permit icmp host 192.168.11.10 host 209.165.10.2

 remark Allow PC1 and PC2 to use mail SMTP
 permit tcp host 192.168.10.10 host 209.165.10.2 eq 25
 permit tcp host 192.168.11.10 host 209.165.10.2 eq 25

 remark Allow PC1 and PC2 to use POP3
 permit tcp host 192.168.10.10 host 209.165.10.2 eq 110
 permit tcp host 192.168.11.10 host 209.165.10.2 eq 110

 remark Allow PC1 and PC2 to use IMAP
 permit tcp host 192.168.10.10 host 209.165.10.2 eq 143
 permit tcp host 192.168.11.10 host 209.165.10.2 eq 143

 remark Block PC1 web access to Server
 deny tcp host 192.168.10.10 host 209.165.10.2 eq 80

 remark Allow PC2 web access to Server
 permit tcp host 192.168.11.10 host 209.165.10.2 eq 80

 remark Allow other traffic
 permit ip any any

exit

interface s0/0/0
 ip access-group EDGE_POLICY in

interface s0/0/1
 ip access-group EDGE_POLICY in

end
