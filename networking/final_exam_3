enable
conf t
hostname R1
no ip domain-lookup

interface g0/0
 description LAN1
 ip address 172.16.1.1 255.255.255.0
 no shutdown

interface g0/1
 description TO-SW3-OSPF
 ip address 172.16.0.1 255.255.255.0
 no shutdown

router ospf 20
 passive-interface default          ! Biến TẤT CẢ các cổng trên Router thành Passive
 no passive-interface GigabitEthernet0/1  ! Chỉ mở lại OSPF cho cổng kết nối với Router khác
 no passive-interface GigabitEthernet0/2  ! Chỉ mở lại OSPF cho cổng kết nối với Router khác
 network 172.16.1.0 0.0.0.255 area 0
 network 172.16.0.0 0.0.0.255 area 0
 network 10.10.10.10 0.0.0.0 area 0

end
