b'0105000000000005150000005b7bb0f398aa2245ad4a1ca451040000'

def sid(h):
    b = bytes.fromhex(h)
    import struct
    rev, cnt = b[0], b[1]
    auth = struct.unpack('>Q', b'\x00\x00' + b[2:8])[0]
    subs = [struct.unpack('<I', b[8+4*i:12+4*i])[0] for i in range(cnt)]
    return "S-{}-{}".format(rev, auth) + ''.join(f"-{s}" for s in subs)

print(sid("0105000000000005150000005b7bb0f398aa2245ad4a1ca451040000"))

