<?xml version="1.0" encoding="UTF-8"?>
<workload name="mix tác vụ metadata" description="Mô phỏng: file-browser, service hay “list prefix/dir”, user vừa xem danh sách vừa tải file, có ghi file mới">
  <storage type="s3" config="accesskey=16OZWI4OZCB2K8DSCNLK;secretkey=XY6MgdHyESgeAhAWhoLk0sOyEJB1FrsP2pd5EIHj;endpoint=phitt-cephs3.hostingviet.com.vn;path_style_access=true"/>
  <workflow>
    <workstage name="init">
      <work type="init" workers="8" config="containers=r(1,200)"/>
    </workstage>

    <workstage name="prepare">
      <work type="prepare" workers="16" config="containers=r(1,200);objects=r(1,10000000);sizes=u(64,512)KB;chunked=false;content=random;hashCheck=false"/>
