        <operation type="read" ratio="60" config="containers=u(1,200);objects=u(1,10000000);hashCheck=false"/>
        <operation type="write" ratio="20" config="containers=u(1,200);objects=u(10000001,12000000);sizes=u(64,512)KB;chunked=false;content=random;hashCheck=false"/>
    </work>
    </workstage>
  </workflow>
