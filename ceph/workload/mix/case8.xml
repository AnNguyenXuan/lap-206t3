<?xml version="1.0" encoding="UTF-8"?>
<workload name="xem xét đọc ghi ít bucket và nhiều bucket" description="So sánh hotspot (ít bucket) và uniform (nhiều bucket) cho mix read/write">
  <storage type="s3" config="accesskey=16OZWI4OZCB2K8DSCNLK;secretkey=XY6MgdHyESgeAhAWhoLk0sOyEJB1FrsP2pd5EIHj;endpoint=phitt-cephs3.hostingviet.com.vn ;path_style_access=true"/>
  <workflow>
    <workstage name="init">
      <work type="init" workers="4" config="containers=r(1,200)"/>
    </workstage>

    <workstage name="prepare">
      <work type="prepare" workers="16" config="containers=r(1,200);objects=r(1,200000);sizes=c(256)KB;chunked=false;content=random;hashCheck=false"/>
    </workstage>

    <workstage name="main_hotspot">
      <work name="main_hotspot" type="normal" workers="64" interval="5" runtime="1200" rampup="60" rampdown="60" afr="200000">
        <operation type="read" ratio="60" config="containers=u(1,5);objects=u(1,200000);hashCheck=false"/>
        <operation type="write" ratio="25" config="containers=u(1,5);objects=u(200001,260000);sizes=c(256)KB;chunked=false;content=random;hashCheck=false"/>
        <operation type="list" ratio="15" config="containers=u(1,5);objects=u(1,260000)"/>
      </work>
    </workstage>

    <workstage name="main_uniform">
      <work name="main_uniform" type="normal" workers="64" interval="5" runtime="1200" rampup="60" rampdown="60" afr="200000">
        <operation type="read" ratio="60" config="containers=u(1,200);objects=u(1,200000);hashCheck=false"/>
        <operation type="write" ratio="25" config="containers=u(1,200);objects=u(260001,320000);sizes=c(256)KB;chunked=false;content=random;hashCheck=false"/>
        <operation type="list" ratio="15" config="containers=u(1,200);objects=u(1,320000)"/>
      </work>
    </workstage>

    <workstage name="cleanup">
      <work type="cleanup" workers="16" config="containers=r(1,200);objects=r(1,320000);deleteContainer=false"/>
    </workstage>

    <workstage name="dispose">
      <work type="dispose" workers="4" config="containers=r(1,200)"/>
    </workstage>
  </workflow>
</workload>
